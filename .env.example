# Local environment variables for ai-revolution
# Copy this file to .env.local and fill in the real values.

# Optional: override the site URL if needed.
# NEXT_PUBLIC_SITE_URL=https://your-local-domain.example

# Neon Postgres (automatically injected by the Vercel Neon integration)
DATABASE_URL=

# Authorize.Net. Use sandbox values until a complete test order succeeds.
AUTHORIZENET_API_LOGIN_ID=
AUTHORIZENET_TRANSACTION_KEY=
AUTHORIZENET_ENVIRONMENT=sandbox
NEXT_PUBLIC_AUTHORIZENET_API_LOGIN_ID=
NEXT_PUBLIC_AUTHORIZENET_CLIENT_KEY=
NEXT_PUBLIC_AUTHORIZENET_ENVIRONMENT=sandbox

# Admin dashboard security. Use long, unique values in Vercel.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
